{
	"name": "pi-extensions",
	"private": true,
	"version": "0.0.0",
	"license": "MIT",
	"packageManager": "pnpm@11.3.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/everyx/pi-extensions"
	},
	"scripts": {
		"check": "biome check .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "pnpm -r test",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.ts": "biome check --write --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@earendil-works/pi-ai": "^0.84.0",
		"@earendil-works/pi-coding-agent": "^0.84.0",
		"@earendil-works/pi-tui": "^0.84.0",
		"@semantic-release/exec": "^7.1.0",
		"@types/node": "^26.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"semantic-release": "^25.0.9",
		"semantic-release-monorepo": "^8.0.2",
		"tsx": "^4.23.1",
		"typebox": "^1.3.6",
		"typescript": "^7.0.2"
	}
}