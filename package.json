{
	"name": "pi-subagent",
	"description": "Sub‑agent tool for pi – delegate tasks to isolated pi instances via tmux",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"type": "module",
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"test": "node --test test/**/*.test.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@earendil-works/pi-tui": "^0.81.1",
		"@types/node": "^26.1.1",
		"typebox": "^1.3.6",
		"typescript": "^7.0.2"
	}
}
