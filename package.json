{
	"name": "@everyx/pi-subagent",
	"version": "0.1.0",
	"description": "Sub‑agent tool for pi – delegate tasks to isolated pi instances via tmux",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/everyx/pi-subagent"
	},
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/*.test.ts"
	},
	"files": [
		"src/",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^26.1.1",
		"tsx": "^4.23.1",
		"typebox": "^1.3.6",
		"typescript": "^7.0.2"
	}
}
