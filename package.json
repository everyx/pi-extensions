{
	"name": "@everyx/pi-subagent",
	"version": "0.0.0-development",
	"description": "Sub‑agent tool for pi – delegate tasks to isolated pi instances via tmux",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"packageManager": "pnpm@11.3.0",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/everyx/pi-subagent"
	},
	"scripts": {
		"check": "biome check .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/*.test.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.ts": "biome check --write --no-errors-on-unmatched"
	},
	"files": [
		"src/",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^26.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"tsx": "^4.23.1",
		"typebox": "^1.3.6",
		"typescript": "^7.0.2"
	}
}
