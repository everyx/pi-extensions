{
	"name": "@everyx/pi-read-doc",
	"version": "1.0.5",
	"description": "Enhanced read for pi – office docs (docx/pdf/pptx/xlsx etc.) via anydoc, header-only, hosted→rapid fallback.",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"scripts": {
		"test": "tsx --test test/*.test.ts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/everyx/pi-extensions"
	},
	"files": [
		"*.ts",
		"README.md",
		"README.zh.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@everyx/pi-ui": "workspace:*",
		"@firecrawl/anydoc": "^0.2.4"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "catalog:",
		"typebox": "catalog:"
	}
}
