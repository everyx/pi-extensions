{
	"name": "@everyx/pi-web-tools",
	"version": "1.2.1",
	"description": "Web primitives for pi — search and URL fetch (URL → Markdown). Multi-provider search with keyless-first quota escalation and a real-browser fallback fuse.",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"scripts": {
		"test": "PI_WEB_TOOLS_NO_BSK=1 tsx --test test/*.test.ts",
		"preview": "tsx preview.ts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/everyx/pi-extensions"
	},
	"files": [
		"*.ts",
		"fetch/",
		"search/",
		"README.md",
		"README.zh.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"typebox": "catalog:"
	},
	"dependencies": {
		"@everyx/pi-ui": "workspace:*",
		"@mozilla/readability": "^0.6.0",
		"exa-js": "^2.16.3",
		"fromnow": "^3.0.1",
		"linkedom": "^0.18.13",
		"turndown": "^7.2.4"
	},
	"devDependencies": {
		"@types/turndown": "^5.0.6"
	}
}
